<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- THE BASE LAYER: MapView -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MAP PICKER CONFIRM BUTTON -->
    <Button
        android:id="@+id/btnConfirmMapLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Destination"
        android:visibility="gone"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#1D4ED8"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toTopOf="@id/rideModuleCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="8dp"/>

    <!-- TOP LAYER: Pill Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#111827" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Where do you want to go?"
                android:textColor="#111827"
                android:textSize="16sp"
                android:paddingStart="16dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RIDE OPTIONS CARD (HIDDEN BY DEFAULT - SHOWN AFTER ROUTE) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/rideModuleCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Your Ride"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="12dp" />

            <!-- Horizontal Scroll for Vehicle Options -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Shared Cab -->
                    <LinearLayout
                        android:id="@+id/cardSharedCab"
                        android:layout_width="85dp"
                        android:layout_height="90dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F9FAFB"
                        android:layout_marginEnd="8dp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚗👥" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shared Cab" android:textSize="10sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginTop="4dp" android:gravity="center"/>
                    </LinearLayout>

                    <!-- Taxi -->
                    <LinearLayout
                        android:id="@+id/cardTaxi"
                        android:layout_width="85dp"
                        android:layout_height="90dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F9FAFB"
                        android:layout_marginEnd="8dp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚕" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taxi" android:textSize="10sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginTop="4dp" android:gravity="center"/>
                    </LinearLayout>

                    <!-- Shared Auto -->
                    <LinearLayout
                        android:id="@+id/cardSharedAuto"
                        android:layout_width="85dp"
                        android:layout_height="90dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F9FAFB"
                        android:layout_marginEnd="8dp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛺👥" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shared Auto" android:textSize="10sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginTop="4dp" android:gravity="center"/>
                    </LinearLayout>

                    <!-- City Bus -->
                    <LinearLayout
                        android:id="@+id/cardCityBus"
                        android:layout_width="85dp"
                        android:layout_height="90dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F9FAFB"
                        android:layout_marginEnd="8dp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚌" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="City Bus" android:textSize="10sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginTop="4dp" android:gravity="center"/>
                    </LinearLayout>

                    <!-- Traveller -->
                    <LinearLayout
                        android:id="@+id/cardTraveller"
                        android:layout_width="85dp"
                        android:layout_height="90dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F9FAFB"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚐" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Traveller" android:textSize="10sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginTop="4dp" android:gravity="center"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RIDE DETAILS CARD (HIDDEN BY DEFAULT) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/rideDetailsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/detailsTransitIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="32sp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/detailsDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination Name"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111827"/>
                    <TextView
                        android:id="@+id/detailsTransitType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shared Cab Pooling"
                        android:textSize="14sp"
                        android:textColor="#6B7280"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est. Fare"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"/>
                    <TextView
                        android:id="@+id/detailsFare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹120"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est. Arrival"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"/>
                    <TextView
                        android:id="@+id/detailsETA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 mins away"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#059669"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnConfirmRide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Confirm Shared Ride"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#111827"
                app:cornerRadius="12dp"/>

            <TextView
                android:id="@+id/btnCancelSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:gravity="center"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- SEARCHING STATE OVERLAY (HIDDEN) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchingOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">
            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#111827"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Searching for nearby peers..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matching you with riders on your route"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ACTIVE RIDE STATUS CARD (HIDDEN) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/activeRideCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride in Progress"
                android:textStyle="bold"
                android:textColor="#059669"
                android:textSize="13sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="24sp"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rajesh (Cab HR 01 X 1234)"
                        android:textStyle="bold"
                        android:textColor="#111827"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 4.8 Rating"
                        android:textSize="12sp"
                        android:textColor="#6B7280"/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnEndRide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End"
                    android:backgroundTint="#EF4444"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ride Tab -->
        <LinearLayout
            android:id="@+id/navRide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/iconRide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/textRide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#111827" />
        </LinearLayout>

        <!-- Services Tab -->
        <LinearLayout
            android:id="@+id/navAllServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/iconServices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/textServices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Services"
                android:textSize="11sp"
                android:textColor="#6B7280" />
        </LinearLayout>

        <!-- Profile Tab -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/iconProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/textProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="#6B7280" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>